# 複製成 .env 後填寫。此檔案不會被送到瀏覽器，修改後請重新啟動系統。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 本機請在飛書「安全設定 > 重定向 URL」填入以下完全相同的網址。
FEISHU_REDIRECT_URI=http://127.0.0.1:8000/auth/feishu/callback

# 若暫時不知道，可先留空並嘗試登入。驗證後會顯示企業識別碼供管理員確認；未設定前無法進入業務系統。
FEISHU_TENANT_KEY=

# 系統登入最長 8 小時，實際有效期與飛書回傳的憑證有效期取較短者。
FEISHU_SESSION_HOURS=8

# 獨立網站留空；共用網站下使用 /money 時，飛書返回網址也須加上 /money。
APP_BASE_PATH=
# Docker 對主機開放的本機連接埠；部署前須確認未被占用。
SIGNING_HOST_PORT=8000
