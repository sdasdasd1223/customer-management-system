# 僅供檢查後加入既有 HTTPS server 區塊，不能取代原有設定。
# 必須先確認 /money 未被使用，並將 18080 換成已確認未占用的主機連接埠。
# .env 對應：APP_BASE_PATH=/money、SIGNING_HOST_PORT=18080。
location = /money {
    return 308 /money/;
}

location ^~ /money/ {
    client_max_body_size 21m;
    # 授權碼不能進入一般含完整 query 的 Nginx 存取紀錄。
    # 本系統仍由 Gunicorn 記錄不含 query 的請求狀態。
    access_log off;
    # 不加尾斜線，保留 /money，交由應用程式掛載層處理。
    proxy_pass http://127.0.0.1:18080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 120s;
}
